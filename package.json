{
  "name": "iot-seer",
  "version": "1.0.0",
  "scripts": {
    "build": "npm run build --workspaces",
    "processing-se": "npm run start -w @iot-seer/processing-service",
    "detection-se": "npm run start -w @iot-seer/anomaly-detection-service",
    "websocket-api-se": "npm run start -w @iot-seer/websocket-api",
    "simulated-data-se": "npm run start -w @iot-seer/simulated-data",
    "http-to-mqtt-se": "npm run start -w @iot-seer/http-mqtt-adapter",
    "all": "npm run build && concurrently \"npm run http-to-mqtt-se\"  \"npm run processing-se\" \"npm run detection-se\" \"npm run websocket-api-se\" "
  },
  "dependencies": {
    "mqtt": "^5.13.2",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "workspaces": [
    "packages/config",
    "packages/types",
    "packages/services/*"
  ]
}
