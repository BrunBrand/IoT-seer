{
  "name": "iot-seer",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "processing-se": "node dist/processing-service/index.js",
    "detection-se": "node dist/anomaly-detection-service/index.js",
    "websocket-api-se": "node dist/websocket-api-service/index.js",
    "simulated-data-se": "node dist/simulated-data/index.js",
    "http-to-mqtt-se": "node dist/http-mqtt-adapter/index.js",
    "all": "npm run build && concurrently \"npm run http-to-mqtt-se\"  \"npm run processing-se\" \"npm run detection-se\" \"npm run websocket-api-se\" "
  },
  "dependencies": {
    "mqtt": "^5.13.2"
  }
}
